# ─────────────────────────────────────────────────────────────────────────────
# Pathfind — Environment Variables
# Copy this file to .env and fill in the values before running docker-compose.
#   cp .env.example .env
# .env is gitignored and should never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Used by both the postgres container and the API container.
POSTGRES_DB=pathfind
POSTGRES_USER=pathfind
# REQUIRED — choose a strong password (e.g. `openssl rand -hex 32`)
POSTGRES_PASSWORD=your_postgres_password_here

# ── Application ───────────────────────────────────────────────────────────────
# REQUIRED — used to sign JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# Environment label (development | staging | production)
ENVIRONMENT=development

# CORS — comma-separated list of allowed frontend origins
# In production set this to your actual frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173

# ── Email Service ─────────────────────────────────────────────────────────────
# Options: console (default, prints to stdout), smtp, ses
EMAIL_SERVICE=console
SENDER_EMAIL=noreply@pathfind.org

# SMTP settings (only needed when EMAIL_SERVICE=smtp)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── AWS / S3 File Storage ─────────────────────────────────────────────────────
# Set USE_S3=true to upload files to S3 instead of local disk.
USE_S3=false
S3_BUCKET_NAME=
AWS_REGION=us-east-1

# AWS credentials (leave blank to use IAM role / instance profile instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
