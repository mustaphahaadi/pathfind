# ─────────────────────────────────────────────────────────────────────────────
# Backend — local development environment variables
# Copy to backend/.env: cp backend/.env.example backend/.env
# Used when running `uvicorn backend.main:app` directly (outside Docker).
# ─────────────────────────────────────────────────────────────────────────────

# SQLite for local dev (default). Switch to PostgreSQL URL for full parity:
# DATABASE_URL=postgresql://pathfind:yourpassword@localhost:5432/pathfind
DATABASE_URL=sqlite:///./pathfind.db

# REQUIRED in production — generate with: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-before-deploying

ENVIRONMENT=development

EMAIL_SERVICE=console
SENDER_EMAIL=noreply@pathfind.org

USE_S3=false
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
